# Google Drive Picker (public browser credentials; never add a client secret)
# Enable both Google Picker API and Google Drive API in the same Cloud project.
GOOGLE_DRIVE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_API_KEY=your-browser-api-key
GOOGLE_DRIVE_APP_ID=your-google-cloud-project-number

# Required on Vercel. Connecting a Blob store in the dashboard usually adds it.
BLOB_READ_WRITE_TOKEN=

# Recommended on Vercel for reliable captions. If the key is present, deployed
# builds select OpenAI automatically unless TRANSCRIPTION_PROVIDER overrides it.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
# TRANSCRIPTION_PROVIDER=openai

# Local-only overrides for the free whisper.cpp provider.
# TRANSCRIPTION_PROVIDER=local-whisper
# WHISPER_MODEL=small
# WHISPER_CPP_PATH=
